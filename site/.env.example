# Required for registration and slug lookup
VITE_PACKAGE_ID=
VITE_REGISTRY_ID=

# testnet | mainnet | devnet | localnet (defaults to testnet)
VITE_SUI_NETWORK=testnet

# Optional: prefill a smart assembly object for SmartObjectProvider (assembly-focused views)
# VITE_OBJECT_ID=

# Public media CDN origin (terraform public_url). Default: https://dapp-media.evefrontier.com
# Do not set this to a *.cloudfront.net distribution hostname.
# VITE_MEDIA_CDN_BASE=https://dapp-media.evefrontier.com

# Optional overrides — public testnet/mainnet defaults apply
VITE_WALRUS_AGGREGATOR_URL=
VITE_WALRUS_UPLOAD_RELAY=
