{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/evefrontier/dapp-index/registry/schema/registry-entry.schema.json",
  "title": "DappIndexRegistryEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "summary",
    "categories",
    "suiPackages",
    "liveUrl",
    "serverTenant"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"
    },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "money",
          "logistics",
          "infrastructure",
          "intel",
          "coordination",
          "build",
          "social"
        ]
      }
    },
    "smartAssemblyTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["storage-unit", "turret", "gate"]
      }
    },
    "liveUrl": { "type": "string", "minLength": 1 },
    "repositoryUrl": { "type": "string", "minLength": 1 },
    "packageIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{64}$"
      }
    },
    "suiPackages": {
      "type": "array",
      "minItems": 1,
      "contains": { "$ref": "#/$defs/coreSuiPackage" },
      "items": { "$ref": "#/$defs/suiPackage" }
    },
    "serverTenant": {
      "type": "string",
      "description": "EVE Frontier game server tenant (not Sui devnet/testnet/mainnet).",
      "enum": ["stillness", "utopia"]
    },
    "maintainer": { "type": "string" },
    "notes": { "type": "string" },
    "thumbnailUrl": { "type": "string", "minLength": 1 },
    "proofs": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://.+" }
          }
        }
      }
    }
  },
  "$defs": {
    "suiObjectId": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "mvrName": {
      "type": "string",
      "pattern": "^(@[a-z0-9][a-z0-9-]*|[a-z0-9][a-z0-9-]*\\.sui)/[a-z0-9][a-z0-9_-]*(?:/[1-9][0-9]*)?$"
    },
    "suiPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "role", "mvrName", "packageId", "packageInfoId"],
      "properties": {
        "network": { "type": "string", "enum": ["mainnet", "testnet"] },
        "role": {
          "type": "string",
          "enum": ["core", "dependency", "utility"]
        },
        "mvrName": { "$ref": "#/$defs/mvrName" },
        "packageId": { "$ref": "#/$defs/suiObjectId" },
        "packageInfoId": { "$ref": "#/$defs/suiObjectId" },
        "modules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "explorerUrl": { "type": "string", "minLength": 1 }
      }
    },
    "coreSuiPackage": {
      "allOf": [
        { "$ref": "#/$defs/suiPackage" },
        {
          "type": "object",
          "required": ["role"],
          "properties": {
            "role": { "const": "core" }
          }
        }
      ]
    }
  }
}
