{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/evefrontier/dapp-index/registry/schema/registry-entry.schema.json",
  "title": "DappIndexRegistryEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "summary",
    "categories",
    "liveUrl",
    "serverTenant"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"
    },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "money",
          "logistics",
          "infrastructure",
          "intel",
          "coordination",
          "build",
          "social"
        ]
      }
    },
    "smartAssemblyTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["storage-unit", "turret", "gate"]
      }
    },
    "liveUrl": { "type": "string", "minLength": 1 },
    "repositoryUrl": { "type": "string", "minLength": 1 },
    "packageIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{64}$"
      }
    },
    "serverTenant": {
      "type": "string",
      "description": "EVE Frontier game server tenant (not Sui devnet/testnet/mainnet).",
      "enum": ["stillness", "utopia"]
    },
    "maintainer": { "type": "string" },
    "notes": { "type": "string" },
    "thumbnailUrl": { "type": "string", "minLength": 1 },
    "proofs": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://.+" }
          }
        }
      }
    }
  }
}
